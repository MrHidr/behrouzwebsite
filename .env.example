# Copy to .env on the server and replace every CHANGE_ME value.
APP_PORT=3000
# Secure default for a reverse proxy on the same host. Change deliberately if needed.
APP_BIND_IP=127.0.0.1
SERVER_URL=https://www.example.com
CMS_ALLOWED_ORIGINS=https://www.example.com
# فقط برای تست موقت روی http://IP برابر false شود؛ production دامنه‌دار باید true بماند.
CMS_SECURE_COOKIES=true

PAYLOAD_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES
POSTGRES_DB=behrouz_cms
POSTGRES_USER=behrouz
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgres://behrouz:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/behrouz_cms
DATABASE_POOL_MAX=10

# Self-hosted abuse protection for the public careers form.
REDIS_URL=redis://redis:6379
CAREER_RATE_LIMIT_REQUIRED=true
TRUST_PROXY_HEADERS=true
# فقط وقتی Nginx مستقیماً پشت Cloudflare معتبر است true شود.
TRUST_CLOUDFLARE_IP_HEADER=false
CAREER_RATE_LIMIT_IP_MAX=5
CAREER_RATE_LIMIT_IP_WINDOW_SECONDS=900
CAREER_RATE_LIMIT_GLOBAL_MAX=100
CAREER_RATE_LIMIT_GLOBAL_WINDOW_SECONDS=3600
CAREER_DUPLICATE_PHONE_HOURS=24

# Password recovery. If omitted, no reset token is logged or emailed.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=cms@example.com
EMAIL_FROM_NAME=Behrouz CMS

# Optional S3-compatible media storage. Leave S3_BUCKET empty to use cms_media.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
