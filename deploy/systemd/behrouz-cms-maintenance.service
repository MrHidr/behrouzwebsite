[Unit]
Description=Behrouz CMS retention maintenance
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/behrouzwebsite
ExecStart=/usr/bin/docker compose -f compose.production.yml run --rm migrate npm run cms:logs:prune
ExecStart=/usr/bin/docker compose -f compose.production.yml run --rm migrate npm run cms:careers:prune
